        "model": "gpt-4o",
        "options": {}
      },
      "id": "c9ea83db-1c2c-44f3-9633-1c51f9648a2a",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
